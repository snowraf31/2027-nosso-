-- ---------------------------------------------------------------------
-- Ferramentas do teste (funções temporárias: somem junto com a transação)
-- ---------------------------------------------------------------------

-- UUID de teste: pg_temp.id('a', 5, 1) = item 1 do restaurante A (ver convenção acima).
-- Só a primeira letra de p_letra conta, então também aceita o prefixo 'aaaaaaaa'.
create function pg_temp.id(p_letra text, p_tipo int, p_n int) returns uuid
language sql immutable as $$
  select format('%s-%s-0000-0000-%s', repeat(left(p_letra, 1), 8), lpad(p_tipo::text, 4, '0'), lpad(p_n::text, 12, '0'))::uuid
$$;

-- Volta ao papel do dono do banco (sem RLS) para montar e conferir dados.
create function pg_temp.voltar_dono() returns void
language plpgsql as $$
begin
  reset role;
  perform set_config('request.jwt.claims', '', true);
end $$;

-- As 10 tabelas multi-restaurante e quantas linhas cada restaurante de teste tem.
create function pg_temp.tabelas() returns table (tabela text, linhas int)
language sql as $$
  select * from (values
    ('restaurants', 1), ('staff', 2), ('tables', 2), ('menu_categories', 2), ('menu_items', 2),
    ('modifier_groups', 2), ('modifier_options', 4), ('item_modifier_groups', 2),
    ('orders', 2), ('order_items', 2)
  ) v (tabela, linhas)
$$;

-- Coluna cujo texto começa com o prefixo do restaurante (a, b ou c) em cada tabela.
create function pg_temp.chave(p_tabela text) returns text
language sql immutable as $$
  select case p_tabela when 'staff' then 'restaurant_id' when 'item_modifier_groups' then 'item_id' else 'id' end
$$;

-- Expressão SQL (alias x) com o restaurante dono da linha, mesmo nas tabelas filhas.
-- Serve para fotografar "tudo que não é do restaurante X", inclusive linhas criadas com id aleatório.
create function pg_temp.dono_sql(p_tabela text) returns text
language sql immutable as $$
  select case p_tabela
    when 'restaurants' then 'x.id'
    when 'modifier_options' then '(select g.restaurant_id from public.modifier_groups g where g.id = x.group_id)'
    when 'item_modifier_groups' then '(select i.restaurant_id from public.menu_items i where i.id = x.item_id)'
    when 'order_items' then '(select o.restaurant_id from public.orders o where o.id = x.order_id)'
    else 'x.restaurant_id'
  end
$$;

-- Colunas de uma tabela do public como "nome tipo, nome tipo": serve para o atacante dos testes
-- criar uma tabela temporária de mesmo nome e mesmo formato (sem NOT NULL nem default).
create function pg_temp.colunas(p_tabela text) returns text
language sql stable as $$
  select string_agg(format('%I %s', a.attname, format_type(a.atttypid, a.atttypmod)), ', ' order by a.attnum)
    from pg_attribute a
   where a.attrelid = ('public.' || p_tabela)::regclass and a.attnum > 0 and not a.attisdropped
$$;

-- Entra como usuário logado (papel "authenticated"), igual ao Supabase: o JWT diz quem é.
create function pg_temp.entrar_como(p_usuario uuid) returns void
language plpgsql as $$
begin
  perform set_config('request.jwt.claims',
                     jsonb_build_object('sub', p_usuario, 'role', 'authenticated')::text, true);
  set local role authenticated;
end $$;

-- Entra como visitante sem login (papel "anon"), como o cliente no celular.
create function pg_temp.entrar_anon() returns void
language plpgsql as $$
begin
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
  set local role anon;
end $$;

-- Quantas linhas o papel atual enxerga (RLS vale). Com prefixo, só as do restaurante daquele prefixo.
create function pg_temp.contar(p_tabela text, p_prefixo text default null) returns bigint
language plpgsql as $$
declare
  v_n bigint;
begin
  if p_prefixo is null then
    execute format('select count(*) from public.%I', p_tabela) into v_n;
  else
    execute format('select count(*) from public.%I where %I::text like %L',
                   p_tabela, pg_temp.chave(p_tabela), p_prefixo || '-%') into v_n;
  end if;
  return v_n;
end $$;

-- Impressão digital de TUDO que não é do restaurante do prefixo (todas as colunas das 10 tabelas).
-- Chamar como dono do banco. Se mudar entre dois momentos, alguma linha de fora foi alterada.
create function pg_temp.foto_fora(p_prefixo text) returns text
language plpgsql as $$
declare
  t record;
  v_parte text;
  v_tudo text := '';
begin
  for t in select tabela from pg_temp.tabelas() order by tabela loop
    execute format($q$select coalesce(string_agg(x::text, '|' order by x::text), '') from public.%I x where coalesce((%s)::text, '') not like %L$q$,
                   t.tabela, pg_temp.dono_sql(t.tabela), p_prefixo || '-%') into v_parte;
    v_tudo := v_tudo || t.tabela || '=' || v_parte || E'\n';
  end loop;
  return md5(v_tudo);
end $$;

-- Roda um UPDATE e devolve quantas linhas ele atingiu.
create function pg_temp.atualizar(p_sql text) returns bigint
language plpgsql as $$
declare
  v_n bigint;
begin
  execute p_sql;
  get diagnostics v_n = row_count;
  return v_n;
end $$;

-- Exige que o banco recuse o comando por PERMISSÃO (SQLSTATE 42501, que cobre tanto
-- "permission denied" quanto "violates row-level security policy"). Se o comando passar,
-- ou falhar por outro motivo (o que mostra que a permissão deixou passar), o teste cai.
create function pg_temp.exige_negado(p_sql text, p_o_que_vazou text) returns void
language plpgsql as $$
begin
  begin
    execute p_sql;
  exception
    when insufficient_privilege then
      return;
    when others then
      raise exception 'FALHA DE SEGURANÇA: % (não foi barrado por permissão; erro: %). Comando: %',
                      p_o_que_vazou, sqlerrm, p_sql;
  end;
  raise exception 'FALHA DE SEGURANÇA: % (o banco aceitou o comando). Comando: %', p_o_que_vazou, p_sql;
end $$;


-- ---------------------------------------------------------------------
-- Regras que dependem da migration 0010 (estritas: não existe mais modo "só avisa")
-- ---------------------------------------------------------------------

-- search_path de função security definer: "blindado" quando termina em pg_temp (ou é vazio).
-- Sem isso, uma tabela temporária criada pelo chamador (com o mesmo nome de uma tabela do
-- public) vem ANTES do public na busca e engana a função, que roda com o poder do dono.
create function pg_temp.search_path_blindado(p_func regprocedure) returns boolean
language sql stable as $$
  select coalesce((
    select s.v in ('', '""', '''''')
           or lower(btrim((string_to_array(s.v, ','))[cardinality(string_to_array(s.v, ','))], ' "''')) = 'pg_temp'
      from (select substr(c, length('search_path=') + 1) as v
              from pg_proc p, unnest(p.proconfig) c
             where p.oid = p_func and c like 'search_path=%') s
  ), false)
$$;

-- Chamada quando uma tabela temporária forjada enganou uma função security definer.
-- Depois da 0010 todas as funções são blindadas: qualquer vazamento derruba o CI, tenha a função
-- o search_path blindado (falha de segurança nova) ou não (a blindagem foi desfeita).
create function pg_temp.vazamento_de_funcao(p_func regprocedure, p_o_que_vazou text) returns void
language plpgsql as $$
begin
  if pg_temp.search_path_blindado(p_func) then
    raise exception 'VAZAMENTO: % (mesmo com o search_path de % terminando em pg_temp)', p_o_que_vazou, p_func;
  end if;
  raise exception 'VAZAMENTO: % (o search_path de % não termina em pg_temp: a 0010 foi desfeita ou a função foi recriada sem ele; use set search_path = public, pg_temp)', p_o_que_vazou, p_func;
end $$;
